# Server-side env vars for the deployed Flask backend.

# URL of the encoder Hugging Face Space — REQUIRED.
# After you push hf_space_encoder/ to a Space, copy the public URL here.
ENCODER_SPACE_URL=https://YOUR_USERNAME-pseudoscorex-encoder.hf.space

# Hugging Face user access token — required for Qwen explanations and for
# private encoder Spaces. Create one at https://huggingface.co/settings/tokens
# (a "read" token is enough).
HF_TOKEN=hf_xxx_your_read_token_here

# Optional. Defaults shown.
LLM_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
LLM_MAX_NEW_TOKENS=120
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
ENCODER_TIMEOUT=60

# Set to 1 to skip the LLM entirely and use rule-based explanations.
DISABLE_LLM_EXPLAINER=0

# ── Checkpoint location ───────────────────────────────────────────────────
# Pick ONE of the two strategies below.
#
# Strategy A (local file): bake best_model_v5.pt into the deploy artefact.
# Strategy B (HF Hub): host the .pt in a HF model repo, downloaded at boot.
# Strategy B is preferred for production — keeps the git repo light and
# decouples model versioning from code versioning.

# Strategy A: path to a local checkpoint file. Used only if CHECKPOINT_HF_REPO
# is unset. Default reads from project root.
CHECKPOINT_PATH=best_model_v5.pt

# Strategy B: HF Hub model repo holding the checkpoint. If set, this takes
# precedence over CHECKPOINT_PATH and the file is fetched (and cached) at boot.
# CHECKPOINT_HF_REPO=YOUR_USERNAME/pseudoscorex-checkpoint
# CHECKPOINT_HF_FILENAME=best_model_v5.pt
# CHECKPOINT_HF_REVISION=main
